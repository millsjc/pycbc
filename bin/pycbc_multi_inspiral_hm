"""
Find multi-detector gravitational wave triggers using a 2 harmonic waveform model
and calculate the 2 filter SNR.
"""

import logging
import time
from collections import defaultdict
import argparse
from math import sqrt, ceil
import numpy as np
from pycbc import (
    detector, fft, init_logging, inject, opt, psd, scheme, strain, vetoes,
    waveform, DYN_RANGE_FAC
)
from pycbc.events import ranking, EventManagerHM, hm_utils, threshold_only
from pycbc.filter import MatchedFilterControlHM
from pycbc.types import zeros, float32, complex64
import pdb
# from pycbc.vetoes import sgchisq
time_init = time.time()
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("-V", "--verbose", action="store_true",
                    help="print extra debugging information",
                    default=False)
parser.add_argument("--output", type=str)
parser.add_argument("--instruments", nargs="+", type=str, required=True,
                    help="List of instruments to analyze.")
parser.add_argument("--bank-file", type=str)
#FIXME: below isn't used as described anymore. Merely acts as a first stage 
# to check if nothing in segment meets this.
parser.add_argument("--snr-threshold", type=float,
                    help="SNR threshold for trigger generation")
parser.add_argument("--low-frequency-cutoff", type=float,
                    help="The low frequency cutoff to use for filtering "
                         "(Hz)")
# add approximant arg
waveform.bank.add_approximant_arg(parser)
parser.add_argument("--order", type=str,
                    help="The integer half-PN order at which to generate the "
                         "approximant.")
parser.add_argument("--taper-template",
                    choices=["start", "end", "startend"],
                    help="For time-domain approximants, taper the start "
                         "and/or end of the waveform before FFTing.")
parser.add_argument("--cluster-method", choices=["template", "window"],
                    default="window",
                    help="Method to use when clustering triggers. 'window' - "
                         "cluster within a fixed time window defined by the "
                         "cluster-window option (default); or 'template' - "
                         "cluster within windows defined by each template's "
                         "chirp length.")
parser.add_argument("--cluster-window", type=float, default=0,
                    help="Length of clustering window in seconds.")
parser.add_argument("--bank-veto-bank-file", type=str)
parser.add_argument("--downsample-factor", type=int, default=1,
                    help="Factor that determines the interval between the "
                         "initial SNR sampling. If not set (or 1) no sparse "
                         "sample is created, and the standard full SNR is "
                         "calculated.")
parser.add_argument("--upsample-threshold", type=float,
                    help="The fraction of the SNR threshold to check the "
                         "sparse SNR sample.")
parser.add_argument("--upsample-method", choices=["pruned_fft"],
                    default='pruned_fft',
                    help="The method to find the SNR points between the "
                         "sparse SNR sample.")
parser.add_argument("--user-tag", type=str, metavar="TAG",
                    help="This is used to identify FULL_DATA jobs for "
                         "compatibility with pipedown post-processing. Option "
                         "will be removed when no longer needed.")
parser.add_argument("--coinc-threshold", type=float, default=0.0,
                    help="Triggers with 2 filter snr below this "
                         "value will be discarded.")
parser.add_argument("--timing-error", type=float, default=0.005,
                    help="timing error in ms to assume when calculating possible "
                         "coincident combinations.")
parser.add_argument("--num-timeslides", type=float, default=0,
                    help="number of timeslides to perform.")
# Add options groups
strain.insert_strain_option_group_multi_ifo(parser)
strain.StrainSegments.insert_segment_option_group_multi_ifo(parser)
psd.insert_psd_option_group_multi_ifo(parser)
scheme.insert_processing_option_group(parser)
fft.insert_fft_option_group(parser)
opt.insert_optimization_option_group(parser)
inject.insert_injfilterrejector_option_group_multi_ifo(parser)
args = parser.parse_args()
init_logging(args.verbose)
#FIXME: pass below on cl once can handle different det combinations.
fixed_ifo_idx = 0

ifo_list = args.instruments
# Put the ifos in alphabetical order so they are always called in
# the same order.
ifo_list.sort()
nifo = len(ifo_list)
if nifo>1:
    # calculate coincident window.
    ifo1 = detector.Detector(ifo_list[0])
    ifo2 = detector.Detector(ifo_list[1])
    time_diff_12 = ifo1.light_travel_time_to_detector(ifo2)
    t2_coinc_window = int(ceil((
        time_diff_12 + args.timing_error) * args.sample_rate[ifo1.name]))
    segment_overlap = t2_coinc_window
    t3_coinc_window=None
    if nifo>2:
        ifo3 = detector.Detector(ifo_list[2])
        time_diff_13 = ifo1.light_travel_time_to_detector(ifo3)
        time_diff_23 = ifo2.light_travel_time_to_detector(ifo3)
        if time_diff_12 > time_diff_13:
            #FIXME: consider switching labels, ifo_list order and anything 
            # else necessary to force this condition
            raise NotImplementedError(
                "t3_coinc_window must be larger than t2_coinc window.")
        alpha_23 = hm_utils.angle_between_detectors(
            time_diff_12, time_diff_13, time_diff_23)
        t3_coinc_window = int(ceil((
            time_diff_13 + args.timing_error) * args.sample_rate[ifo1.name]))
        t23_coinc_window = int(ceil((
            time_diff_23 + args.timing_error) * args.sample_rate[ifo1.name]))
        segment_overlap = max(segment_overlap, t3_coinc_window)
else:
    segment_overlap = 0

strain.verify_strain_options_multi_ifo(args, parser, ifo_list)
strain.StrainSegments.verify_segment_options_multi_ifo(
        args, parser, ifo_list)
psd.verify_psd_options_multi_ifo(args, parser, ifo_list)
scheme.verify_processing_options(args, parser)
fft.verify_fft_options(args, parser)
inj_filter_rejector = inject.InjFilterRejector.from_cli_multi_ifos(
    args, ifo_list)
strain_dict = strain.from_cli_multi_ifos(
    args, ifo_list, inj_filter_rejector, dyn_range_fac=DYN_RANGE_FAC)
strain_segments_dict = strain.StrainSegments.from_cli_multi_ifos(
    args, strain_dict, ifo_list, 
    segment_overlap=segment_overlap / args.sample_rate[ifo_list[0]])
analyze_slices = strain_segments_dict[ifo_list[0]].analyze_slices
analyze_lengths = [asl.stop - asl.start for asl in analyze_slices]

if nifo>1:
    logging.info("Calculating possible coincident combinations")
    idx_combinations = {a_len: hm_utils.index_combinations(a_len, t2_coinc_window, 
        t3_coinc_window, np.int64) for a_len in np.unique(analyze_lengths)}
    logging.info("Finished calculating possible coincident combinations")
    if nifo>2:
        logging.info("Removing unphysical combinations")
        for a_len, _idx_combinations in idx_combinations.items():
            n2 = _idx_combinations[:,0] - _idx_combinations[:,1]
            n3 = _idx_combinations[:,0] - _idx_combinations[:,2]
            _cond = hm_utils.check_time_delay_is_physical(
                n2, n3, t2_coinc_window, t3_coinc_window, alpha_23)
            idx_combinations[a_len] = idx_combinations[a_len][_cond]
            logging.info("Removed {}/{} ({:.1f}%) unphysical combinations".format(
                len(_cond) - len(idx_combinations[a_len]), len(_cond), 
                100 * (len(_cond) - len(idx_combinations[a_len])) / len(_cond)))

max_num_slides = hm_utils.max_number_timeslides(
    idx_combinations[min(analyze_lengths)], t2_coinc_window, t3_coinc_window)
assert args.num_timeslides < max_num_slides, f"Cannot request more than \
    {max_num_slides} timeslides for this analysis length"

pdb.set_trace()
ctx = scheme.from_cli(args)
with ctx:
    fft.from_cli(args)
    # Set some often used variables for easy access
    flow = args.low_frequency_cutoff
    sample_rate = strain_dict[ifo_list[0]].sample_rate
    flen = strain_segments_dict[ifo_list[0]].freq_len
    tlen = strain_segments_dict[ifo_list[0]].time_len
    delta_f = strain_segments_dict[ifo_list[0]].delta_f
    try:
        for ifo in ifo_list:
            assert(sample_rate == strain_dict[ifo].sample_rate)
            assert(flen == strain_segments_dict[ifo].freq_len)
            assert(tlen == strain_segments_dict[ifo].time_len)
            assert(delta_f == strain_segments_dict[ifo].delta_f)
    except:
        err_msg = "Sample rate, frequency spacing, frequency length "
        err_msg += "and time length must be consistent across ifos."
        raise ValueError(err_msg)
    logging.info("Making frequency-domain data segments")
    segments = {ifo: strain_segments_dict[ifo].fourier_segments()
        for ifo in ifo_list}
    del strain_segments_dict
    psd.associate_psds_to_multi_ifo_segments(
        args, segments, strain_dict, flen, delta_f, flow, ifo_list,
        dyn_range_factor=DYN_RANGE_FAC, precision='single')
    # Currently we are using the same matched-filter parameters for all
    # ifos. Therefore only one MatchedFilterControl needed. Maybe this can
    # change if needed. Segments is only used to get tlen etc. which is
    # same for all ifos, so just send the first ifo
    template_mem_dom = zeros(tlen, dtype=complex64)
    template_mem_sub = zeros(tlen, dtype=complex64)
    template_mem_sub_perp = zeros(tlen, dtype=complex64)
    # FIXME: The single detector SNR threshold should not necessarily be
    #        applied to every IFO (usually only 2 most sensitive in
    #        network)
    # FIXME: currently passing template_mem_sub_perp as the temp memory 
    # change this when the orthogonalization is done in a better place.
    matched_filter = {
        ifo: MatchedFilterControlHM(
            args.low_frequency_cutoff, None, args.snr_threshold, tlen, delta_f,
            complex64, segments[ifo], template_mem_dom, template_mem_sub_perp, 
            use_cluster=False,
            downsample_factor=args.downsample_factor,
            upsample_threshold=args.upsample_threshold,
            upsample_method=args.upsample_method, cluster_function='symmetric')
        for ifo in ifo_list}

    logging.info("Overwhitening frequency-domain data segments")
    for ifo in ifo_list:
        for seg in segments[ifo]:
            seg /= seg.psd
    ifo_out_types = {
        'time_index': int,
        'ifo': int, # IFO is stored as an int internally!
        'snr_dominant': complex64,
        'snr_subdominant': complex64,
        'sigma_sub_perp': float32,
        }
    ifo_out_vals = {
        'time_index': None,
        'ifo': None,
        'snr_dominant': None,
        'snr_subdominant': None,
        'sigma_sub_perp': None,
        }
    ifo_out_names = sorted(ifo_out_vals.keys())
    network_out_types = {
        'snr_2_filter_rss': float32,
        'snr_2_filter': float32,
        'nifo': int,
        'timeslide_id': int,
        }
    network_out_vals = {
        'snr_2_filter_rss': None,
        'snr_2_filter': None,
        'nifo': None,
        'timeslide_id': None,
        }
    network_names = sorted(network_out_vals.keys())
    event_mgr = EventManagerHM(
        args, ifo_list, ifo_out_names,
        [ifo_out_types[n] for n in ifo_out_names], network_names,
        [network_out_types[n] for n in network_names])
    logging.info("Read in template bank")
    bank = waveform.FilterBankHM(
        args.bank_file, flen, delta_f, complex64, low_frequency_cutoff=flow,
        phase_order=args.order, taper=args.taper_template,
        approximant=args.approximant, out_dom=template_mem_dom,
        out_sub=template_mem_sub, out_sub_perp=template_mem_sub_perp)
    # Use injfilterrejector to reduce the bank to only those templates that
    # might actually find something
    n_bank = len(bank)
    nfilters = 0
    logging.info("Full template bank size: %d", n_bank)
    for ifo in ifo_list:
        bank.template_thinning(inj_filter_rejector[ifo])
    if not len(bank) == n_bank:
        n_bank = len(bank)
        logging.info("Template bank size after thinning: %d", n_bank)
    n_segments = len(segments[ifo_list[0]])
    # Loop over templates
    for t_num, (template_dom, template_sub) in enumerate(bank):
        # Loop over segments
        for s_num in range(n_segments):
            stilde = {ifo : segments[ifo][s_num] for ifo in ifo_list}
            # Filter check checks the 'inj_filter_rejector' options to
            # determine whether to filter this template/segment 
            # if injections are present.
            analyse_segment = True
            for ifo in ifo_list:
                if not inj_filter_rejector[ifo].template_segment_checker(
                        bank, t_num, stilde[ifo]):
                    logging.info(
                        "Skipping segment %d/%d with template %d/%d as no "
                        "detectable injection is present",
                        s_num + 1, len(segments[ifo]), t_num + 1, n_bank)
                    analyse_segment = False
            # Find detector sensitivities (sigma) and make array of
            # normalised
            sigmasq_dom = {
                ifo : template_dom.sigmasq(stilde[ifo].psd)
                for ifo in ifo_list}
            sigma_dom = {ifo : sqrt(sigmasq_dom[ifo]) for ifo in ifo_list}
            sigmasq_sub = {
                ifo : template_sub.sigmasq(stilde[ifo].psd)
                for ifo in ifo_list}
            sigma_sub = {ifo : sqrt(sigmasq_sub[ifo]) for ifo in ifo_list}
            # Every time s_num is zero or we skip the segment, we run new 
            # template to increment the template index
            if s_num==0:
                event_mgr.new_template(tmplt=template_dom.params, 
                    sigmasq_dom=sigmasq_dom, sigmasq_sub=sigmasq_sub)
            if not analyse_segment: continue
            logging.info(
                "Analyzing segment %d/%d", s_num + 1, len(segments[ifo]))
            sigma_sub_perp_dict = dict.fromkeys(ifo_list)
            snr_dom_dict = dict.fromkeys(ifo_list)
            snr_sub_dict = dict.fromkeys(ifo_list)
            norm_dom_dict = dict.fromkeys(ifo_list)
            norm_sub_dict = dict.fromkeys(ifo_list)
            corr_dom_dict = dict.fromkeys(ifo_list)
            corr_sub_dict = dict.fromkeys(ifo_list)
            idx = dict.fromkeys(ifo_list)
            snr_2_filt_rss_above_thresh_dict = dict.fromkeys(ifo_list)
            snr_2_filt_rss_dict = dict.fromkeys(ifo_list)
            n_single_trigs = 0
            for ifo in ifo_list:
                logging.info(
                    "Filtering template %d/%d, ifo %s", t_num + 1, n_bank, ifo)
                # No clustering until the end.
                # The correlation vector is the FFT of the snr (so inverse
                # FFT it to get the snr).
                logging.info("Orthogonalizing subdominant harmonic")
                template_sub_perp, sigma_sub_perp = \
                    bank.orthogonalize_subdominant_harmonic(
                        matched_filter[ifo].segments[s_num].psd, 
                        sigma_dom[ifo], sigma_sub[ifo],
                        template_dom, template_sub)
                sigma_sub_perp_dict[ifo] = sigma_sub_perp
                snr_dom, snr_sub, norm_dom, norm_sub, corr_dom, corr_sub, \
                ind, snr_2_filt_rss_above_thresh, snr_2_filt_rss = \
                     matched_filter[ifo].matched_filter_and_cluster(
                         s_num, sigma_dom[ifo], sub_template_norm=1, window=0)
                         # above we assume the orthoganlized template is 
                         # normalized. Check this.
                analyze = matched_filter[ifo].segments[s_num].analyze
                snr_dom_dict[ifo] = (snr_dom[analyze] * norm_dom)
                snr_sub_dict[ifo] = (snr_sub[analyze] * norm_sub)
                norm_dom_dict[ifo] = norm_dom
                norm_sub_dict[ifo] = norm_sub
                corr_dom_dict[ifo] = corr_dom.copy()
                corr_sub_dict[ifo] = corr_sub.copy()
                idx[ifo] = ind.copy()
                snr_2_filt_rss_above_thresh_dict[ifo] = snr_2_filt_rss_above_thresh.copy()
                n_single_trigs += len(snr_2_filt_rss_above_thresh)
                snr_2_filt_rss_dict[ifo] = snr_2_filt_rss.copy()
            # Move onto next segment if there are no triggers.
            if n_single_trigs==0: continue

            if nifo>1:
                # START new looping code here
                logging.info("Calculating network rss 2 filter snr and thresholding")
                network_snr_2_filter_rss, det_idx = hm_utils.detector_sum_and_threshold(
                    np.array([snr_2_filt_rss_dict[ifo] for ifo in ifo_list]),
                    idx_combinations[analyze_lengths[s_num]],
                    args.coinc_threshold)
                logging.info("Finished calculating rss snr and thresholding")
                n_combinations = len(idx_combinations[analyze_lengths[s_num]])
                logging.info("{} ({}%) possible coincs are above threshold".format(
                    len(det_idx), 100 * float(len(det_idx)) / n_combinations))
                num_events = len(det_idx)
                if num_events > 0:
                    logging.info("Calculating final stat and thresholding")
                    network_snr_2_filter, det_idx, mask = hm_utils.snr_2_filter_and_threshold(
                        np.array([snr_dom_dict[ifo] for ifo in ifo_list]),
                        np.array([snr_sub_dict[ifo] for ifo in ifo_list]),
                        det_idx,
                        args.coinc_threshold)
                    logging.info("Finished calculating final stat and thresholding")
                    logging.info("{} ({:.1f}%) possible coincs are above threshold".format(
                        len(det_idx), 100 * float(len(det_idx)) / n_combinations))

                    logging.info("Finding the maximum stat value for each time "
                        "point in {}".format(ifo_list[fixed_ifo_idx]))
                    i_max = hm_utils.maximal_coinc_in_ifo(
                        network_snr_2_filter, det_idx[:,fixed_ifo_idx])
                    snr_2_filter = network_snr_2_filter[i_max]
                    det_idx = det_idx[i_max]
                    snr_2_filter_rss = network_snr_2_filter_rss[mask][i_max]
                    num_events = len(det_idx)
                    logging.info("{} unique times in {} have coincident triggers"
                        "".format(num_events, ifo_list[fixed_ifo_idx]))
            else:
                det_idx, snr_2_filter_rss = threshold_only(snr_2_filt_rss,
                                                args.coinc_threshold)
                det_idx = np.array([det_idx]).T
                snr_2_filter = snr_2_filter_rss
                num_events = len(det_idx)
            if num_events > 0:
                logging.info("Max snr 2 filter = %.2f", max(snr_2_filter))
                coinc_idx = {ifo: det_idx[:, i] for i, ifo in enumerate(ifo_list)}
                for ifo in ifo_list:
                    ifo_out_vals['time_index'] = (
                        np.int64(coinc_idx[ifo]) + stilde[ifo].cumulative_index
                        )
                    ifo_out_vals['snr_dominant'] = abs(snr_dom_dict[ifo][coinc_idx[ifo]])
                    ifo_out_vals['snr_subdominant'] = abs(snr_sub_dict[ifo][coinc_idx[ifo]])
                    # IFO is stored as an int
                    ifo_out_vals['ifo'] = ([event_mgr.ifo_dict[ifo]] * num_events)
                    ifo_out_vals['sigma_sub_perp'] = ([
                        sigma_sub_perp_dict[ifo]] * num_events)
                    event_mgr.add_template_events_to_ifo(
                        ifo, ifo_out_names, [ifo_out_vals[n] for n in ifo_out_names])
                network_out_vals['snr_2_filter_rss'] = snr_2_filter_rss
                network_out_vals['snr_2_filter'] = snr_2_filter
                network_out_vals['nifo'] = [nifo] * num_events
                # network_out_vals['timeslide_id'] = 
                event_mgr.add_template_events_to_network(
                    network_names,
                    [network_out_vals[n] for n in network_names])
        # Now cluster
        if args.cluster_method == "window":
            cluster_window = int(args.cluster_window * sample_rate)
        elif args.cluster_method == "template":
            cluster_window = int(template.chirp_length * sample_rate)
        # pdb.set_trace()
        event_mgr.cluster_template_network_events_single_ifo(
            "time_index", "snr_2_filter", cluster_window, ifo_list[fixed_ifo_idx])
        event_mgr.finalize_template_events(
            "time_index", "snr_2_filter", ifo_list[fixed_ifo_idx])
event_mgr.write_events(args.output)
logging.info("Finished")
logging.info("Time to complete analysis: %.0f s", time.time() - time_init)