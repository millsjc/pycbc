"""
Split hdf bank files.
"""
import argparse
import h5py
import os
import tqdm
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)

parser.add_argument("-V", "--verbose", action="store_true",
                    help="print extra debugging information",
                    default=False)
parser.add_argument("--outdir", type=str)
parser.add_argument("--inputfile", type=str)
parser.add_argument("--num-splits", type=int)

def slices(num_temps, num_splits):
    stride = int(num_temps/num_splits)
    start, stop = 0, stride + 1
    while stop <= num_temps:
        start += stride
        stop += stride
        yield slice(start, stop)

def splitbank(inputfile, outdir, num_splits):
    Path(outdir).mkdir(parents=True, exist_ok=True)
    outfile = os.path.join(outdir, Path(inputfile).stem + "_SPLITBANK_{}.hdf")

    with h5py.File(inputfile, "r") as h5in:
        num_temps = len((list(h5in.values())[0]))
        attributes = dict(h5in.attrs)
        for i, s in tqdm.tqdm(
            enumerate((slices(num_temps, num_splits))), 
            desc="splitting the bank",
            total=num_splits):
            with h5py.File(outfile.format(i), "w") as h5out:
                h5out.attrs.update(attributes)
                for k, v in h5in.items():
                    if not isinstance(v, h5py.Dataset):
                        raise NotImplementedError("Currently can only copy "
                            "type h5py.Dataset.")
                    h5out[k] = v[s]

args = parser.parse_args()

splitbank(args.inputfile, args.outdir, args.num_splits)